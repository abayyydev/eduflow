# ==============================================================================
# EDUFlow LMS - Production Environment Variables Template
# Copy and configure these variables in Vercel Project Settings -> Environment Variables
# ==============================================================================

# 1. DATABASE CONNECTION (cPanel MySQL Database)
# Pastikan fitur "Remote MySQL" di cPanel sudah mengizinkan IP Vercel (%)
# Contoh format:
# DATABASE_URL="mysql://<cpanel_db_user>:<cpanel_db_password>@<cpanel_domain_atau_ip>:3306/<cpanel_db_name>"
DATABASE_URL="mysql://user_eduflow:PasswordDatabase123!@domainanda.com:3306/user_eduflow"

# 2. AUTHENTICATION & SECURITY
# Kunci enkripsi sesi JWT (wajib diisi minimal 32 karakter acak)
AUTH_SECRET="generate-kunci-rahasia-acak-32-karakter-untuk-keamanan-jwt"

# 3. DOMAIN UTAMA APLIKASI
# URL domain Vercel Anda (atau custom domain kampus)
APP_URL="https://eduflow-app.vercel.app"

# 4. STORAGE CONFIGURATION
# Di Vercel serverless, gunakan /tmp/submissions
STORAGE_TYPE="local"
STORAGE_LOCAL_DIR="/tmp/submissions"
