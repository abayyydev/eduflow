# Database Connection
DATABASE_URL="mysql://root:@localhost:3306/eduflow"

# Authentication & Session Security
# Generate a secure 32+ character random string in production
AUTH_SECRET="eduflow-insecure-dev-secret-replace-in-production-min32chars"
APP_URL="http://localhost:3000"

# Storage Settings (Development uses local private folder; production uses S3 compatible storage)
STORAGE_TYPE="local"
STORAGE_LOCAL_DIR="./storage/submissions"
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
